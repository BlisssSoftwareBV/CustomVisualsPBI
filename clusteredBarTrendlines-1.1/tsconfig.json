{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": ".tmp/build",
    "types": ["node"]
  },
  "files": ["src/visual.ts"],
  "include": ["src/**/*.ts", "tests/**/*.ts", "preview/**/*.ts"]
}